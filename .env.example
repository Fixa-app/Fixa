NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
RESEND_FROM="Fixa <automated@hifixa.com>"
# Anthropic API key — used by /api/parse-quote to read uploaded quotes via Claude Vision
ANTHROPIC_API_KEY=

# --- App subdomain split (Model B) — set these in PRODUCTION only ---
# Leave all three EMPTY for local dev and Vercel previews. Setting them locally
# would scope cookies to hifixa.com (no effect on localhost) and turn on
# cross-host redirects that don't apply off-domain.
#   NEXT_PUBLIC_COOKIE_DOMAIN=.hifixa.com        (shares the session across subdomains)
#   NEXT_PUBLIC_APP_URL=https://app.hifixa.com   (the pro app host)
#   NEXT_PUBLIC_MARKETING_URL=https://hifixa.com (the marketing host)
NEXT_PUBLIC_COOKIE_DOMAIN=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MARKETING_URL=
